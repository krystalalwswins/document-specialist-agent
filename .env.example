# AIO Sandbox
SANDBOX_BASE_URL=http://localhost:8080
SANDBOX_WORKSPACE=/home/gem/workspace
SANDBOX_API_KEY=
SANDBOX_DEFAULT_TIMEOUT=30
SANDBOX_MAX_TIMEOUT=120
SANDBOX_HTTP_GRACE=10
SANDBOX_CPUS=2.0
SANDBOX_MEMORY=4g
SANDBOX_PIDS_LIMIT=512

# === One-shot execution container (design note 14) ===
# 每次代码工具调用启动一个一次性容器，由可信宿主侧通过 docker exec 驱动；
# 容器 network=none、read-only 根文件系统，退出或超时后强制销毁。
# 下面这组是新的执行后端配置；上面的 SANDBOX_BASE_URL / SANDBOX_WORKSPACE /
# SANDBOX_API_KEY 是遗留 HTTP 后端配置，迁移完成后删除。
#
# 镜像必须固定摘要（tag 会漂移）。本机已验证：
# enterprise-public-cn-beijing.cr.volces.com/vefaas-public/all-in-one-sandbox:1.11.0@sha256:6328d7fd2f0ff0b4c147c3d05b3df1ce331f4a482eb6e550ecd64ed1fcf906e7
SANDBOX_IMAGE=enterprise-public-cn-beijing.cr.volces.com/vefaas-public/all-in-one-sandbox:1.11.0@sha256:6328d7fd2f0ff0b4c147c3d05b3df1ce331f4a482eb6e550ecd64ed1fcf906e7
# 容器内运行身份，禁止 root。1000/1000 只在本机（Windows Docker Desktop）验证过：
# 该镜像没有专用账号，挂载写权限实际由宿主文件共享身份决定，
# 其他环境必须靠启动期 ContainerSupervisor.preflight() 确认，不能根据宿主用户名猜。
SANDBOX_UID=1000
SANDBOX_GID=1000
# 调用级目录根（control/ 永不参与产物提交，out/ 是唯一产物来源，logs/ 存 stdout/stderr）
SANDBOX_CALL_ROOT=.data/sandbox_calls
# 宿主侧工作区根目录：工具仍使用 /home/gem/workspace/tasks/<task_id> 这样的虚拟路径，
# 由 TaskWorkspace 映射到该宿主目录，再以只读方式挂载进一次性容器
SANDBOX_HOST_WORKSPACE=.data/sandbox_workspace
SANDBOX_MEMORY_SWAP=4g
# stdout/stderr 采集上限（字节）；超过后标记 output_truncated，超出部分不可回读
SANDBOX_OUTPUT_SPOOL_MAX_BYTES=33554432
# 产物提交配额：文件数 / 总字节数，超限则整次调用按不确定终止
SANDBOX_COMMIT_MAX_FILES=64
SANDBOX_COMMIT_MAX_TOTAL_BYTES=268435456
# 孤儿容器 TTL：由宿主侧 OrphanSweeper 扫描并按精确 Container ID 清理
SANDBOX_ORPHAN_TTL_SECONDS=300

# JSON arrays. Exclude run_python / sandbox.execute to disable arbitrary code.
ALLOWED_TOOLS=["run_python","read_file","parse_document","save_report","read_tool_output","search_memory"]
ALLOWED_PERMISSIONS=["sandbox.execute","file.read","artifact.write","tool_output.read","memory.read"]
REPORT_PREFIX=reports
# 允许作为任务输入（OSS -> 沙箱）的对象前缀
INPUT_PREFIX=raw

# MinIO / S3-compatible object storage
MINIO_ENDPOINT=http://localhost:9000
# 生成下载链接时使用的对外地址；留空则用 MINIO_ENDPOINT（仅本机可用）。
# 预签名 URL 的签名覆盖 Host，所以这里必须是与 MINIO_ENDPOINT 不同的“对外可访问地址”。
MINIO_PUBLIC_ENDPOINT=
# MinIO 在宿主机上的监听地址：127.0.0.1 = 仅本机，0.0.0.0 = 局域网可访问
MINIO_BIND_HOST=127.0.0.1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword
MINIO_BUCKET_NAME=doc-agent-storage

# LLM (OpenAI-compatible, e.g. DeepSeek)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 单次调用超时（秒）与重试预算：只对瞬态故障（超时/连接/429/5xx）重试
LLM_TIMEOUT=60
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY=1
LLM_RETRY_MAX_DELAY=10
# 可选的本地费用估算：版本与三档 USD/百万 Token 单价必须同时配置。
# 不配置时仍记录 Token，但 estimated_cost_usd=null；请按实际供应商合同手动填写。
# LLM_PRICING_VERSION=provider-contract-2026-09
# LLM_INPUT_PRICE_USD_PER_MILLION=1.00
# LLM_CACHED_INPUT_PRICE_USD_PER_MILLION=0.10
# LLM_OUTPUT_PRICE_USD_PER_MILLION=2.00

# 任务落盘与僵死回收
# 任务 JSON 落盘目录：进程重启后轨迹仍在
TASK_STORE_DIR=.data/tasks
# 无进展超过该秒数的非终态任务，启动时/运行期会被判定 FAILED
TASK_STALE_AFTER_SECONDS=1800
TASK_REAPER_INTERVAL_SECONDS=60
# 任务执行并发：worker 数 + 可排队数，超出后 POST /tasks 返回 429
TASK_MAX_WORKERS=2
TASK_MAX_PENDING=32
# 产物校验失败后允许的修复重试次数（0 = 直接判失败）
TASK_MAX_RECOVERY_ATTEMPTS=1
# 核心 Agent Loop 的累计 Token 预算：soft 触发上下文收敛，hard 终止任务
TASK_SOFT_TOKEN_BUDGET=200000
TASK_HARD_TOKEN_BUDGET=300000

# 工具大结果卸载：完整内容保存在本地，仅把预览和逻辑引用放入模型上下文
TOOL_OUTPUT_STORE_DIR=.data/tool_outputs
TOOL_OUTPUT_INLINE_CHARS=16000
TOOL_OUTPUT_PREVIEW_CHARS=2000
# read_tool_output 单次最多回读的字符数，必须不超过 INLINE_CHARS 的一半
TOOL_OUTPUT_READ_MAX_CHARS=4000

# 上下文治理：hard limit 已为模型输出预留 8000 tokens
CONTEXT_WINDOW_TOKENS=64000
CONTEXT_OUTPUT_RESERVE_TOKENS=8000
CONTEXT_SOFT_LIMIT_TOKENS=48000
CONTEXT_HARD_LIMIT_TOKENS=56000
CONTEXT_TARGET_TOKENS=32000
# 每次压缩优先保留最近几个完整消息组
CONTEXT_RECENT_GROUPS=2
CONTEXT_SUMMARY_MAX_CHARS=6000
# 单次压缩请求重试次数 / 连续多少轮压缩失败后打开熔断器
CONTEXT_COMPACTION_MAX_ATTEMPTS=2
CONTEXT_COMPACTION_FAILURE_THRESHOLD=2

# 本地长期记忆：SQLite 持久化 + user/project 过滤 + 关键词 Top-K（不使用向量库）
MEMORY_ENABLED=true
MEMORY_DB_PATH=.data/memory/memory.db
MEMORY_RECALL_TOP_K=5
MEMORY_MIN_CONFIDENCE=0.8
MEMORY_MAX_CONTENT_CHARS=800

# 文档解析（parse_document）返回给模型的字符预算，超出部分写入 <文件名>.md
DOCUMENT_MAX_CHARS=20000

# HTTP API access token. Empty = auth disabled (local development only).
# When set, every request must send header: X-API-Token: <value>
API_TOKEN=

# Local trace storage (T1 foundation; automatic instrumentation comes in T2/T3)
TRACE_STORE_DIR=.data/traces
TRACE_INLINE_BYTES=16000
TRACE_ENABLED=true
TRACE_PROMPT_VERSION=harness-prompts-v1
# Optional exact deployed commit; leave unset when unknown
# TRACE_CODE_VERSION=...

# T4: opt-in Langfuse export. No additional SDK dependency; OTLP/HTTP JSON.
# Create project keys in Langfuse, then fill these LOCALLY. Never commit keys.
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENVIRONMENT=development
LANGFUSE_EXPORT_INTERVAL=5
LANGFUSE_EXPORT_TIMEOUT=10
LANGFUSE_EXPORT_MAX_ATTEMPTS=5
LANGFUSE_PAYLOAD_MAX_BYTES=128000
# Extra structured keys removed on export, in addition to baseline credential rules.
LANGFUSE_REDACT_KEYS=["email","phone"]
