# AIO Sandbox
SANDBOX_BASE_URL=http://localhost:8080
SANDBOX_WORKSPACE=/home/gem/workspace
SANDBOX_API_KEY=
SANDBOX_DEFAULT_TIMEOUT=30
SANDBOX_MAX_TIMEOUT=120
SANDBOX_HTTP_GRACE=10
SANDBOX_CPUS=2.0
SANDBOX_MEMORY=4g
SANDBOX_PIDS_LIMIT=512
# JSON arrays. Exclude run_python / sandbox.execute to disable arbitrary code.
ALLOWED_TOOLS=["run_python","read_file","parse_document","save_report","read_tool_output","search_memory"]
ALLOWED_PERMISSIONS=["sandbox.execute","file.read","artifact.write","tool_output.read","memory.read"]
REPORT_PREFIX=reports
# 允许作为任务输入（OSS -> 沙箱）的对象前缀
INPUT_PREFIX=raw

# MinIO / S3-compatible object storage
MINIO_ENDPOINT=http://localhost:9000
# 生成下载链接时使用的对外地址；留空则用 MINIO_ENDPOINT（仅本机可用）。
# 预签名 URL 的签名覆盖 Host，所以这里必须是与 MINIO_ENDPOINT 不同的“对外可访问地址”。
MINIO_PUBLIC_ENDPOINT=
# MinIO 在宿主机上的监听地址：127.0.0.1 = 仅本机，0.0.0.0 = 局域网可访问
MINIO_BIND_HOST=127.0.0.1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword
MINIO_BUCKET_NAME=doc-agent-storage

# LLM (OpenAI-compatible, e.g. DeepSeek)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 单次调用超时（秒）与重试预算：只对瞬态故障（超时/连接/429/5xx）重试
LLM_TIMEOUT=60
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY=1
LLM_RETRY_MAX_DELAY=10
# 可选的本地费用估算：版本与三档 USD/百万 Token 单价必须同时配置。
# 不配置时仍记录 Token，但 estimated_cost_usd=null；请按实际供应商合同手动填写。
# LLM_PRICING_VERSION=provider-contract-2026-09
# LLM_INPUT_PRICE_USD_PER_MILLION=1.00
# LLM_CACHED_INPUT_PRICE_USD_PER_MILLION=0.10
# LLM_OUTPUT_PRICE_USD_PER_MILLION=2.00

# 任务落盘与僵死回收
# 任务 JSON 落盘目录：进程重启后轨迹仍在
TASK_STORE_DIR=.data/tasks
# 无进展超过该秒数的非终态任务，启动时/运行期会被判定 FAILED
TASK_STALE_AFTER_SECONDS=1800
TASK_REAPER_INTERVAL_SECONDS=60
# 任务执行并发：worker 数 + 可排队数，超出后 POST /tasks 返回 429
TASK_MAX_WORKERS=2
TASK_MAX_PENDING=32
# 产物校验失败后允许的修复重试次数（0 = 直接判失败）
TASK_MAX_RECOVERY_ATTEMPTS=1
# 核心 Agent Loop 的累计 Token 预算：soft 触发上下文收敛，hard 终止任务
TASK_SOFT_TOKEN_BUDGET=200000
TASK_HARD_TOKEN_BUDGET=300000

# 工具大结果卸载：完整内容保存在本地，仅把预览和逻辑引用放入模型上下文
TOOL_OUTPUT_STORE_DIR=.data/tool_outputs
TOOL_OUTPUT_INLINE_CHARS=16000
TOOL_OUTPUT_PREVIEW_CHARS=2000
# read_tool_output 单次最多回读的字符数，必须不超过 INLINE_CHARS 的一半
TOOL_OUTPUT_READ_MAX_CHARS=4000

# 上下文治理：hard limit 已为模型输出预留 8000 tokens
CONTEXT_WINDOW_TOKENS=64000
CONTEXT_OUTPUT_RESERVE_TOKENS=8000
CONTEXT_SOFT_LIMIT_TOKENS=48000
CONTEXT_HARD_LIMIT_TOKENS=56000
CONTEXT_TARGET_TOKENS=32000
# 每次压缩优先保留最近几个完整消息组
CONTEXT_RECENT_GROUPS=2
CONTEXT_SUMMARY_MAX_CHARS=6000
# 单次压缩请求重试次数 / 连续多少轮压缩失败后打开熔断器
CONTEXT_COMPACTION_MAX_ATTEMPTS=2
CONTEXT_COMPACTION_FAILURE_THRESHOLD=2

# 本地长期记忆：SQLite 持久化 + user/project 过滤 + 关键词 Top-K（不使用向量库）
MEMORY_ENABLED=true
MEMORY_DB_PATH=.data/memory/memory.db
MEMORY_RECALL_TOP_K=5
MEMORY_MIN_CONFIDENCE=0.8
MEMORY_MAX_CONTENT_CHARS=800

# 文档解析（parse_document）返回给模型的字符预算，超出部分写入 <文件名>.md
DOCUMENT_MAX_CHARS=20000

# HTTP API access token. Empty = auth disabled (local development only).
# When set, every request must send header: X-API-Token: <value>
API_TOKEN=
