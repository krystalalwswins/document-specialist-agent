# AIO Sandbox
SANDBOX_BASE_URL=http://localhost:8080
SANDBOX_WORKSPACE=/home/gem/workspace
SANDBOX_API_KEY=
SANDBOX_DEFAULT_TIMEOUT=30
SANDBOX_MAX_TIMEOUT=120
SANDBOX_HTTP_GRACE=10
SANDBOX_CPUS=2.0
SANDBOX_MEMORY=4g
SANDBOX_PIDS_LIMIT=512
# JSON arrays. Exclude run_python / sandbox.execute to disable arbitrary code.
ALLOWED_TOOLS=["run_python","read_file","save_report","parse_document","read_step_output"]
ALLOWED_PERMISSIONS=["sandbox.execute","file.read","artifact.write"]
REPORT_PREFIX=reports

# MinIO / S3-compatible object storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword
MINIO_BUCKET_NAME=doc-agent-storage

# LLM (OpenAI-compatible, e.g. DeepSeek)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Persistent local task history
TASK_DB_PATH=data/tasks.sqlite3
MAX_CONCURRENT_TASKS=4

# Learning runtime budgets (cooperative deadlines, not sandbox process termination)
TASK_TIMEOUT_SECONDS=300
MAX_TOOL_CALLS=24
MAX_ITERATIONS=8
CONTEXT_MAX_CHARS=24000
TASK_QUEUE_CAPACITY=100
LLM_TIMEOUT_SECONDS=60
# Optional parser: install requirements-mcp.txt and start demo.mcp_parser_server
MCP_PARSER_URL=
MCP_PARSER_TOOL=parse_document
